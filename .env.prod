# ======================
# APP CONFIGURATION
# ======================
APP_NAME=ecommerce-service
BUILD_VERSION=1.0.0

# ======================
# JAVA PERFORMANCE
# ======================
# Heap size cho Spring Boot
JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC

# ======================
# DATABASE (PostgreSQL)
# ======================
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_VOLUME=postgres_data
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=M@ngo0710

# Spring DataSource (container hostname)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ecommerce_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=M@ngo0710

# Hikari Connection Pool
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000

# ======================
# REDIS
# ======================
#SPRING_DATA_REDIS_HOST=redis
#SPRING_DATA_REDIS_PORT=6379
#SPRING_DATA_REDIS_TIMEOUT=2s

# ======================
# ACTUATOR & LOGGING
# ======================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
LOGGING_LEVEL_ROOT=INFO

