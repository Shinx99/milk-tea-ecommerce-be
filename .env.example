# ===== TEAM TEMPLATE =====
# cp .env.example .env
# docker compose up --build

# ===== Application =====
APP_NAME=ecommerce
BUILD_VERSION=1.0.0
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JAVA_OPTS=

# ===== PostgreSQL Container =====
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_VOLUME=postgres_data
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=change-me-postgres-password

# ===== Spring DataSource (container hostnames) =====
# ví dụ: jdbc:postgresql://postgres:5432/ecommerce_db
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ecommerce_db
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=change-me-postgres-password

# ===== Hikari Pool =====
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000

# ===== Redis (prepared for future caching) =====
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=2000

# ===== JPA/Flyway =====
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# ===== DevTools Hot Reload (local only) =====
SPRING_DEVTOOLS_RESTART_ENABLED=false
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=false
SPRING_DEVTOOLS_RESTART_POLL_INTERVAL=1000
SPRING_DEVTOOLS_RESTART_QUIET_PERIOD=400

# ===== Actuator & Logging =====
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
LOGGING_LEVEL_ROOT=INFO

# ===== Email =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password-or-app-password

# ===== JWT =====
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY=86400000   # 24h in milliseconds

# ===== WebConfig =====
# Frontend base URL (for reset password links, redirect after payment, etc.)
APP_FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================
# ENCRYPTION (for sensitive data in DB)
# =============================================
ENCRYPTION_SECRET=change-me-encryption-secret

# =============================================
# PAYMENT CONFIGURATION
# =============================================
PAYMENT_QR_EXPIRY_MINUTES=15
PAYMENT_POLLING_INTERVAL_MS=3000
PAYMENT_MAX_POLLING_ATTEMPTS=100
PAYMENT_MIN_AMOUNT=1000
PAYMENT_MAX_AMOUNT=50000000

# =============================================
# PAYMENT GATEWAY CONFIGURATION (VNPay)
# =============================================
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://your-domain.ngrok-free.dev/api/payments/vnpay/return
VNPAY_IPN_URL=https://your-domain.ngrok-free.dev/api/payments/vnpay/ipn
# Replace "your-domain.ngrok-free.dev" with your own domain or ngrok URL in your real .env

# ===== WebConfig for production (example) =====
#APP_FRONTEND_BASE_URL=https://your-real-frontend-domain.com
#CORS_ALLOWED_ORIGINS=https://your-real-frontend-domain.com,https://www.your-real-frontend-domain.com

# =============================================
# Gemini
# =============================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_TIMEOUT=30s
