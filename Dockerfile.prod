           Dockerfile.prod
# =========================
# Stage 1: Build JAR
# =========================
FROM maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app

# Copy pom và tải dependencies để tận dụng cache
COPY pom.xml ./
RUN mvn -B dependency:go-offline

# Copy source và build JAR
COPY . .
RUN mvn -B clean package -DskipTests

# =========================
# Stage 2: Runtime (prod)
# =========================
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy JAR từ stage build
COPY --from=build /app/target/*.jar app.jar

# Expose port HTTP của Spring Boot
EXPOSE 8080

# Health check (optional nhưng nên có)
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/healt>

# Sử dụng shell form để đọc JAVA_OPTS từ environment
ENTRYPOINT sh -c "java $JAVA_OPTS -jar /app/app.jar"

